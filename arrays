9. Find Majority Element (> n/2 Times)
n = int(input())
arr = list(map(int, input().split()))

candidate = None
count = 0

for x in arr:
    if count == 0:
        candidate = x

    if x == candidate:
        count += 1
    else:
        count -= 1

if arr.count(candidate) > n // 2:
    print(candidate)
else:
    print(-1)
