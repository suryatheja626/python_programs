6. Maximum Subarray Sum (Kadane's Algorithm)
n = int(input())
arr = list(map(int, input().split()))

curr = ans = arr[0]

for x in arr[1:]:
    curr = max(x, curr + x)
    ans = max(ans, curr)

print(ans)
