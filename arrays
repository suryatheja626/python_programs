19. Sort Array of 0s, 1s and 2s (Dutch National Flag)
n = int(input())
arr = list(map(int, input().split()))

low = mid = 0
high = n - 1

while mid <= high:
    if arr[mid] == 0:
        arr[low], arr[mid] = arr[mid], arr[low]
        low += 1
        mid += 1
    elif arr[mid] == 1:
        mid += 1
    else:
        arr[mid], arr[high] = arr[high], arr[mid]
        high -= 1

print(*arr)
20. Maximum Product Subarray
n = int(input())
arr = list(map(int, input().split()))

mx = mn = ans = arr[0]

for x in arr[1:]:
    if x < 0:
        mx, mn = mn, mx

    mx = max(x, mx * x)
    mn = min(x, mn * x)

    ans = max(ans, mx)

print(ans)
