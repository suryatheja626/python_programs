19. Longest Palindromic Substring (Brute Force)
s = input()

ans = ""

for i in range(len(s)):
    for j in range(i+1, len(s)+1):
        t = s[i:j]
        if t == t[::-1] and len(t) > len(ans):
            ans = t

print(ans)
20. Group Anagrams
from collections import defaultdict

arr = input().split()

d = defaultdict(list)

for word in arr:
    key = "".join(sorted(word))
    d[key].append(word)

print(list(d.values()))
