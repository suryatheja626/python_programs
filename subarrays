18. Count Subarrays Divisible by K
from collections import defaultdict

arr = list(map(int,input().split()))
k = int(input())

count = defaultdict(int)

count[0] = 1

prefix = 0
ans = 0

for x in arr:
    prefix += x

    rem = prefix % k

    ans += count[rem]

    count[rem] += 1

print(ans)
19. Maximum Sum Circular Subarray
arr = list(map(int,input().split()))

total = sum(arr)

currMax = bestMax = arr[0]
currMin = bestMin = arr[0]

for x in arr[1:]:

    currMax = max(x,currMax+x)
    bestMax = max(bestMax,currMax)

    currMin = min(x,currMin+x)
    bestMin = min(bestMin,currMin)

if bestMax < 0:
    print(bestMax)
else:
    print(max(bestMax,total-bestMin))
