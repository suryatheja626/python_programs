3. Print Maximum Sum Subarray
arr = list(map(int, input().split()))

curr = arr[0]
best = arr[0]
start = end = temp = 0

for i in range(1, len(arr)):
    if curr + arr[i] < arr[i]:
        curr = arr[i]
        temp = i
    else:
        curr += arr[i]

    if curr > best:
        best = curr
        start = temp
        end = i

print(arr[start:end+1])
4. Count Subarrays with Sum K
from collections import defaultdict

arr = list(map(int, input().split()))
k = int(input())

prefix = 0
count = 0

mp = defaultdict(int)
mp[0] = 1

for x in arr:
    prefix += x
    count += mp[prefix-k]
    mp[prefix] += 1

print(count)
5. Longest Subarray with Sum K
arr = list(map(int, input().split()))
k = int(input())

mp = {}
prefix = 0
ans = 0

for i in range(len(arr)):
    prefix += arr[i]

    if prefix == k:
        ans = i + 1

    if prefix-k in mp:
        ans = max(ans, i-mp[prefix-k])

    if prefix not in mp:
        mp[prefix] = i

print(ans)
6. Smallest Subarray with Sum ≥ K
arr = list(map(int, input().split()))
k = int(input())

left = 0
total = 0
ans = float('inf')

for right in range(len(arr)):
    total += arr[right]

    while total >= k:
        ans = min(ans, right-left+1)
        total -= arr[left]
        left += 1

print(ans if ans != float('inf') else 0)
7. Maximum Product Subarray
arr = list(map(int, input().split()))

mx = mn = ans = arr[0]

for x in arr[1:]:

    if x < 0:
        mx, mn = mn, mx

    mx = max(x, mx*x)
    mn = min(x, mn*x)

    ans = max(ans, mx)

print(ans)
