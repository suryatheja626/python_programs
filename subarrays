13. Maximum Average Subarray of Size K
arr = list(map(int,input().split()))
k = int(input())

window = sum(arr[:k])

ans = window

for i in range(k,len(arr)):
    window += arr[i]-arr[i-k]
    ans = max(ans,window)

print(ans/k)
