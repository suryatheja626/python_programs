6. Longest Repeating Character Replacement
from collections import defaultdict

s = input()
k = int(input())

count = defaultdict(int)

left = 0
mx = 0
ans = 0

for right in range(len(s)):
    count[s[right]] += 1
    mx = max(mx, count[s[right]])

    while (right-left+1)-mx > k:
        count[s[left]] -= 1
        left += 1

    ans = max(ans, right-left+1)

print(ans)
