19. Maximum Number of Vowels in a Window
s=input()
k=int(input())

vowels=set("aeiou")

count=0

for i in range(k):
    if s[i] in vowels:
        count+=1

ans=count

for i in range(k,len(s)):
    if s[i-k] in vowels:
        count-=1
    if s[i] in vowels:
        count+=1
    ans=max(ans,count)

print(ans)
