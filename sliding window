1. Maximum Sum Subarray of Size K
Question

Given an array and an integer k, find the maximum sum of any subarray of size k.

n = int(input())
arr = list(map(int, input().split()))
k = int(input())

window = sum(arr[:k])
ans = window

for i in range(k, n):
    window += arr[i] - arr[i-k]
    ans = max(ans, window)

print(ans)
2. First Negative Number in Every Window of Size K
from collections import deque

n = int(input())
arr = list(map(int, input().split()))
k = int(input())

q = deque()

for i in range(n):

    if arr[i] < 0:
        q.append(i)

    while q and q[0] <= i-k:
        q.popleft()

    if i >= k-1:
        if q:
            print(arr[q[0]], end=" ")
        else:
            print(0, end=" ")
3. Maximum Element in Every Window
from collections import deque

arr = list(map(int, input().split()))
k = int(input())

dq = deque()

for i in range(len(arr)):

    while dq and dq[0] <= i-k:
        dq.popleft()

    while dq and arr[dq[-1]] <= arr[i]:
        dq.pop()

    dq.append(i)

    if i >= k-1:
        print(arr[dq[0]], end=" ")
4. Minimum Size Subarray Sum ≥ Target
arr = list(map(int, input().split()))
target = int(input())

left = 0
total = 0
ans = float('inf')

for right in range(len(arr)):
    total += arr[right]

    while total >= target:
        ans = min(ans, right-left+1)
        total -= arr[left]
        left += 1

print(ans if ans != float('inf') else 0)
