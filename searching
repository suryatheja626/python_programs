4. Count Occurrences of an Element
def first(arr, x):
    l, r = 0, len(arr) - 1
    ans = -1

    while l <= r:
        mid = (l + r) // 2

        if arr[mid] == x:
            ans = mid
            r = mid - 1
        elif arr[mid] < x:
            l = mid + 1
        else:
            r = mid - 1

    return ans


def last(arr, x):
    l, r = 0, len(arr) - 1
    ans = -1

    while l <= r:
        mid = (l + r) // 2

        if arr[mid] == x:
            ans = mid
            l = mid + 1
        elif arr[mid] < x:
            l = mid + 1
        else:
            r = mid - 1

    return ans


arr = list(map(int, input().split()))
x = int(input())

f = first(arr, x)
l = last(arr, x)

print(0 if f == -1 else l - f + 1)
