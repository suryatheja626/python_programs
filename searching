17. Find Majority Element
arr = list(map(int, input().split()))

candidate = None
count = 0

for x in arr:
    if count == 0:
        candidate = x

    if x == candidate:
        count += 1
    else:
        count -= 1

if arr.count(candidate) > len(arr) // 2:
    print(candidate)
else:
    print(-1)
