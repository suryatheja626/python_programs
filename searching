19. Search in Infinite Sorted Array (Concept)
arr = list(map(int, input().split()))
x = int(input())

i = 1

while i < len(arr) and arr[i] < x:
    i *= 2

l = i // 2
r = min(i, len(arr) - 1)

while l <= r:
    mid = (l + r) // 2

    if arr[mid] == x:
        print(mid)
        break
    elif arr[mid] < x:
        l = mid + 1
    else:
        r = mid - 1
else:
    print(-1)
20. Median of Two Sorted Arrays (Merge Method)
a = list(map(int, input().split()))
b = list(map(int, input().split()))

c = sorted(a + b)

n = len(c)

if n % 2:
    print(c[n // 2])
else:
    print((c[n // 2] + c[n // 2 - 1]) / 2)
