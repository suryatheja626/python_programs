19. Employee Salary
class Employee:
    def __init__(self, basic):
        self.basic = basic

    def salary(self):
        hra = 0.2 * self.basic
        da = 0.1 * self.basic
        return self.basic + hra + da

e = Employee(50000)

print(e.salary())
20. ATM System
class ATM:
    def __init__(self):
        self.balance = 1000

    def deposit(self, amt):
        self.balance += amt

    def withdraw(self, amt):
        if amt <= self.balance:
            self.balance -= amt
        else:
            print("Insufficient Balance")

    def check(self):
        print(self.balance)

a = ATM()

a.deposit(500)
a.withdraw(300)

a.check()
